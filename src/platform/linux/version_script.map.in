# alloc8 version script for Linux
# Controls symbol visibility and GLIBC versioning. The GLIBC base version is
# substituted by CMake (configure_file with @ONLY) — see CMakeLists.txt for the
# per-arch logic. Exporting below the minimum version a binary requests causes
# ld.so to silently bypass LD_PRELOAD.
#
# NOTE: aligned_alloc is exported separately under GLIBC_2.16 (when it was
# introduced) to ensure LD_PRELOAD interposition works correctly. Without this,
# programs compiled against glibc 2.16+ would bind to libc's aligned_alloc
# instead of the custom allocator's version.

@ALLOC8_GLIBC_BASE_VERSION@ {
  global:
    # Core allocation functions
    malloc;
    free;
    calloc;
    realloc;
    memalign;
    posix_memalign;
    # aligned_alloc is in GLIBC_2.16 section below

    # C23 sized free
    free_sized;
    free_aligned_sized;

    # Size query
    malloc_usable_size;

    # String functions
    strdup;
    strndup;

    # Page-aligned allocation
    valloc;
    pvalloc;

    # GNU extensions
    reallocarray;
    cfree;
    mallopt;
    malloc_trim;
    malloc_stats;
    mallinfo;

    # Internal libc names
    __libc_malloc;
    __libc_free;
    __libc_calloc;
    __libc_realloc;
    __libc_memalign;

    # C++ operators
    _Znwm;                    # operator new(size_t)
    _Znam;                    # operator new[](size_t)
    _ZdlPv;                   # operator delete(void*)
    _ZdaPv;                   # operator delete[](void*)
    _ZnwmRKSt9nothrow_t;      # operator new(size_t, nothrow)
    _ZnamRKSt9nothrow_t;      # operator new[](size_t, nothrow)
    _ZdlPvRKSt9nothrow_t;     # operator delete(void*, nothrow)
    _ZdaPvRKSt9nothrow_t;     # operator delete[](void*, nothrow)
    _ZdlPvm;                  # operator delete(void*, size_t)
    _ZdaPvm;                  # operator delete[](void*, size_t)

    # C++17 aligned new/delete
    _ZnwmSt11align_val_t;     # operator new(size_t, align_val_t)
    _ZnamSt11align_val_t;     # operator new[](size_t, align_val_t)
    _ZdlPvSt11align_val_t;    # operator delete(void*, align_val_t)
    _ZdaPvSt11align_val_t;    # operator delete[](void*, align_val_t)

    # C++14+17 sized + aligned delete
    _ZdlPvmSt11align_val_t;   # operator delete(void*, size_t, align_val_t)
    _ZdaPvmSt11align_val_t;   # operator delete[](void*, size_t, align_val_t)

    # xxmalloc interface (for debugging/direct calls)
    xxmalloc;
    xxfree;
    xxfree_sized;
    xxfree_aligned_sized;
    xxrealloc;
    xxcalloc;
    xxmemalign;
    xxmalloc_usable_size;
    xxmalloc_lock;
    xxmalloc_unlock;

    # Thread lifecycle hooks (optional, for thread-aware allocators)
    pthread_create;
    pthread_exit;
    xxthread_init;
    xxthread_cleanup;
    xxthread_created_flag;

  local:
    *;
};

# aligned_alloc was introduced in glibc 2.16. It must be versioned separately
# for LD_PRELOAD interposition to work on binaries compiled against glibc 2.16+.
# The version inheritance ensures this section is compatible with the base version.
GLIBC_2.16 {
  global:
    aligned_alloc;
} @ALLOC8_GLIBC_BASE_VERSION@;
